<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.forme.host</string>
  <key>ProgramArguments</key><array><string>/Library/ForMe/bin/forme-hostd</string><string>--config</string><string>/Library/Application Support/ForMe/config/host.json</string></array>
  <key>RunAtLoad</key><true/>
  <!-- launchd has no finite failure-count/escalating-delay primitive.
       KeepAlive is intentionally omitted; this input is not release-ready
       until a native bounded recovery adapter is verified. -->
  <key>HardResourceLimits</key><dict><key>NumberOfFiles</key><integer>4096</integer></dict>
</dict></plist>
