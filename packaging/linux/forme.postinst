#!/bin/sh
set -eu

umask 077
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
[ "$(id -u)" -eq 0 ] || {
  echo 'forme: package configuration requires root' >&2
  exit 1
}
[ -x /usr/bin/systemctl ] || {
  echo 'forme: systemd service manager is unavailable' >&2
  exit 1
}

case "${1:-}" in
  configure)
    if [ -r /etc/os-release ]; then
      . /etc/os-release
    fi
    if [ "${ID:-}" != ubuntu ] || [ "${VERSION_ID:-}" != 24.04 ]; then
      echo "forme: this package supports Ubuntu 24.04 only" >&2
      exit 1
    fi
    package_arch=$(dpkg --print-architecture 2>/dev/null || uname -m)
    case "$package_arch" in
      amd64|x86_64) target=ubuntu2404_x86_64 ;;
      arm64|aarch64) target=ubuntu2404_arm64 ;;
      *) echo "forme: unsupported package architecture: $package_arch" >&2; exit 1 ;;
    esac
    getent group forme-brain >/dev/null || groupadd --system forme-brain
    getent passwd forme-brain >/dev/null || useradd --system --gid forme-brain --home-dir /var/lib/forme/brain --shell /usr/sbin/nologin forme-brain
    getent group forme-web >/dev/null || groupadd --system forme-web
    getent passwd forme-web >/dev/null || useradd --system --gid forme-web --home-dir /var/lib/forme/web-auth --shell /usr/sbin/nologin forme-web
    getent group forme-bridge >/dev/null || groupadd --system forme-bridge
    /bin/sh /opt/forme/packaging/posix/service-access.sh linux prepare
    /opt/forme/bin/forme-hostctl prepare-installation \
      --install-root /opt/forme \
      --state-root /var/lib/forme \
      --config-root /etc/forme \
      --log-root /var/log/forme \
      --ipc-root /run/forme \
      --target "$target" \
      --bundle-inventory /opt/forme/bundle-inventory.json
    /bin/sh /opt/forme/packaging/posix/service-access.sh linux apply
    /bin/sh /opt/forme/packaging/posix/service-access.sh linux verify
    systemctl daemon-reload
    systemctl enable forme-host.service forme-web.service forme-brain.service
    systemctl start forme-host.service forme-web.service
    ;;
esac
