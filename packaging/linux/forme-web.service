[Unit]
Description=forme web workbench
After=forme-host.service
Requires=forme-host.service
# systemd counts the initial start plus at most three automatic restarts in
# this window. The fixed delay is a bounded POSIX fallback, not proof of the
# Windows 5s -> 30s -> 120s schedule; native package acceptance remains open
# until the target systemd version can express the canonical schedule.
StartLimitIntervalSec=86400
StartLimitBurst=4

[Service]
Type=exec
User=forme-web
Group=forme-web
SupplementaryGroups=forme-bridge
ExecStart=/opt/forme/bin/forme-webd --config /etc/forme/web.json
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/forme/web-auth /var/log/forme/web
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
