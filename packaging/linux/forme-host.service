[Unit]
Description=forme managed host
After=local-fs.target
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=exec
User=root
Group=root
ExecStart=/opt/forme/bin/forme-hostd --config /etc/forme/host.json
Restart=on-failure
RestartSec=5s
TimeoutStopSec=90s
NoNewPrivileges=no
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/forme/host-state /var/lib/forme/logs /run/forme
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
