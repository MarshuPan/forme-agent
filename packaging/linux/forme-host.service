[Unit]
Description=forme managed host
After=local-fs.target
# systemd counts the initial start plus at most three automatic restarts in
# this window. The fixed delay is a bounded POSIX fallback, not proof of the
# Windows 5s -> 30s -> 120s schedule; native package acceptance remains open
# until the target systemd version can express the canonical schedule.
StartLimitIntervalSec=86400
StartLimitBurst=4

[Service]
Type=exec
User=root
Group=root
ExecStart=/opt/forme/bin/forme-hostd --config /etc/forme/host.json
Restart=on-failure
RestartSec=5s
TimeoutStopSec=90s
NoNewPrivileges=no
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/etc/forme /var/lib/forme/host-state /var/lib/forme/keys/model-credentials /var/lib/forme/backups /var/log/forme/host /run/forme -/opt/forme/releases
RuntimeDirectory=forme
RuntimeDirectoryMode=0700
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
