[Unit]
Description=forme owner brain
Wants=network-online.target
After=network-online.target forme-host.service
Requires=forme-host.service
ConditionPathExists=/etc/forme/core/core.json
# systemd counts the initial start plus at most three automatic restarts in
# this window. The fixed delay is a bounded POSIX fallback, not proof of the
# Windows 5s -> 30s -> 120s schedule; native package acceptance remains open
# until the target systemd version can express the canonical schedule.
StartLimitIntervalSec=86400
StartLimitBurst=4

[Service]
Type=exec
User=forme-brain
Group=forme-brain
SupplementaryGroups=forme-bridge
ExecStart=/opt/forme/bin/forme-gatewayd --config /etc/forme/core/core.json
Restart=on-failure
RestartSec=5s
TimeoutStopSec=90s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/forme/brain /var/log/forme/brain /var/lib/forme/workspaces
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
