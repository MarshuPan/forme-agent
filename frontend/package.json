{
  "name": "forme-workbench",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
